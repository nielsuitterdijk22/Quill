# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# Credentials come from the environment, not this file:
#   export SCW_ACCESS_KEY=...            # API access key (owner or IAM manager)
#   export SCW_SECRET_KEY=...
#   export SCW_DEFAULT_ORGANIZATION_ID=...
#   export SCW_DEFAULT_REGION=fr-par
#   export SCW_DEFAULT_ZONE=fr-par-1

# Root domain for the deployment. The DNS zone is created in Scaleway DNS;
# delegate the domain to the output `dns_name_servers` at your registrar.
domain = "quill.example.com"

# S3 bucket for backups — must be unique within the region.
backup_bucket_name = "quill-mvp-backups-<random-suffix>"

# Optional overrides:
# region         = "fr-par"        # EU (Paris) — pinned per SUITE.md EU residency
# zone           = "fr-par-1"
# project_name   = "quill-mvp"
# k8s_version    = "1.33"
# node_type      = "DEV1-M"
# node_count     = 2
# rdb_node_type  = "db-dev1-m"
# registry_namespace = "quill"
# kubeconfig_path = "kubeconfig"   # write cluster kubeconfig to this local file
#
# After the first apply, set the LB IPs so DNS A records are managed by TF
# (scripts/dns-sync.sh automates this):
# ingress_lb_ip = "203.0.113.10"  # kubectl -n kube-system get svc traefik ... ip
# ssh_lb_ip     = "203.0.113.11"  # kubectl -n quill get svc forgejo-ssh ... ip
