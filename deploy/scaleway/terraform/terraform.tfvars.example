# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# Credentials come from the environment, not this file:
#   export SCW_ACCESS_KEY=...
#   export SCW_SECRET_KEY=...
#   export SCW_DEFAULT_ORGANIZATION_ID=...
#   export SCW_DEFAULT_REGION=fr-par
#   export SCW_DEFAULT_ZONE=fr-par-1

# Root domain for the deployment. The DNS zone is created in Scaleway DNS;
# delegate the domain to the output `dns_name_servers` at your registrar.
domain = "quill.example.com"

# ACME email for the git.<domain> Let's Encrypt cert (Caddy HTTP-01 on the VM).
letsencrypt_email = "ops@example.com"

# S3 bucket for backups — must be unique within the region.
backup_bucket_name = "quill-mvp-backups-<random-suffix>"

# Optional overrides:
# region            = "fr-par"   # EU (Paris) — pinned per SUITE.md EU residency
# project_name      = "quill-mvp"
# image_tag         = "latest"   # CI sets this to the git SHA
# sdb_min_cpu       = 0          # scale-to-zero DB when idle
# sdb_max_cpu       = 4
# container_cpu     = 1000       # mCPU per container instance
# container_memory_mb = 1024
# container_max_scale = 2
# vm_type           = "DEV1-S"  # the single Forgejo/dispatch VM
# vm_root_volume_gb = 20
# ssh_cidrs         = ["<your-egress-ip>/32"]  # tighten SSH access
# backup_schedule   = "0 3 * * *"
#
# Post-provision (scripts/provision.sh prints the commands):
# forgejo_admin_token      = "..."   # minted on the Forgejo VM
# zitadel_management_token = "..."   # harvested from zitadel container logs
#
# Transactional email via Brevo (optional; CI passes these from GH secrets
# BREVO_SMTP_NAME / BREVO_SMTP_KEY and var BREVO_SMTP_FROM):
# brevo_smtp_host     = "smtp-relay.brevo.com"
# brevo_smtp_port     = 587          # 587 STARTTLS / 465 implicit TLS
# brevo_smtp_user     = "xxx@smtp-brevo.com"   # Brevo SMTP login
# brevo_smtp_password = "xsmtpib-..."          # Brevo SMTP key (do NOT commit; use -var)
# brevo_smtp_from     = "no-reply@quill.example.com"  # default; domain must be authenticated in Brevo
#
# GitHub OAuth app for onboarding repo import. Create it at
# github.com/settings/developers > OAuth Apps with the callback URL
#   https://api.<domain>/api/v1/auth/github/callback
# and pass the credentials via -var or CI secrets (never commit real values):
# github_client_id     = "Iv1...."
# github_client_secret = "..."

# Creem merchant-of-record (plan upgrades). Leave unset until the account +
# product exist; the Upgrade button then reports "not activated".
# creem_api_key         = ""
# creem_webhook_secret  = ""   # webhook URL: https://api.black-tulip.nl/api/v1/webhooks/creem
# creem_team_product_id = ""   # org upgrades (Team)
# creem_pro_product_id  = ""   # personal upgrades (Pro)
