# Scaleway Secret Manager — single source of truth for all credentials.
# The Kubernetes `quill-app-secrets` Secret is populated from these values by
# deploy/scaleway/scripts/sync-secrets.sh (scw CLI) or from CI secrets; nothing
# secret is ever committed to git or baked into images.
#
# `protected = false` keeps values readable by operators/CI for rotation and
# disaster recovery. Flip to true once an external recovery procedure exists.

locals {
  secret_path_prefix = "/quill"
}

resource "scaleway_secret" "rdb_admin_password" {
  name       = "rdb-admin-password"
  path       = "${local.secret_path_prefix}/rdb"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "rdb_admin_password" {
  secret_id   = scaleway_secret.rdb_admin_password.id
  region      = var.region
  data        = random_password.rdb_admin.result
  description = "RDB admin (quill) password, generated by Terraform"
}

resource "scaleway_secret" "zitadel_db_password" {
  name       = "zitadel-db-password"
  path       = "${local.secret_path_prefix}/rdb"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "zitadel_db_password" {
  secret_id   = scaleway_secret.zitadel_db_password.id
  region      = var.region
  data        = random_password.zitadel_db.result
  description = "RDB zitadel user password, generated by Terraform"
}

resource "scaleway_secret" "jwt_secret" {
  name       = "jwt-secret"
  path       = "${local.secret_path_prefix}/app"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "jwt_secret" {
  secret_id   = scaleway_secret.jwt_secret.id
  region      = var.region
  data        = random_password.jwt_secret.result
  description = "QUILL_JWT_SECRET"
}

resource "scaleway_secret" "secret_encryption_key" {
  name       = "secret-encryption-key"
  path       = "${local.secret_path_prefix}/app"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "secret_encryption_key" {
  secret_id   = scaleway_secret.secret_encryption_key.id
  region      = var.region
  data        = base64encode(random_password.secret_encryption_key.result)
  description = "QUILL_SECRET_ENCRYPTION_KEY (base64 32-byte AES-256-GCM key)"
}

resource "scaleway_secret" "webhook_secret" {
  name       = "webhook-secret"
  path       = "${local.secret_path_prefix}/app"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "webhook_secret" {
  secret_id   = scaleway_secret.webhook_secret.id
  region      = var.region
  data        = random_password.webhook_secret.result
  description = "QUILL_WEBHOOK_SECRET (HMAC for Forgejo webhooks)"
}

resource "scaleway_secret" "dispatch_secret" {
  name       = "dispatch-secret"
  path       = "${local.secret_path_prefix}/app"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "dispatch_secret" {
  secret_id   = scaleway_secret.dispatch_secret.id
  region      = var.region
  data        = random_password.dispatch_secret.result
  description = "QUILL_PIPELINE_DISPATCH_SECRET (api <-> dispatch HMAC)"
}

resource "scaleway_secret" "forgejo_admin_token" {
  name        = "forgejo-admin-token"
  path        = "${local.secret_path_prefix}/app"
  project_id  = scaleway_account_project.quill.id
  region      = var.region
  protected   = false
  description = "FORGEJO_ADMIN_TOKEN. Placeholder until scripts/k8s-provision.sh mints the real token on first boot and updates this secret."
}

resource "scaleway_secret_version" "forgejo_admin_token" {
  secret_id   = scaleway_secret.forgejo_admin_token.id
  region      = var.region
  data        = random_password.forgejo_admin_token_placeholder.result
  description = "placeholder — replaced by k8s-provision.sh after first boot"
  lifecycle {
    ignore_changes = [data]
  }
}

resource "scaleway_secret" "zitadel_masterkey" {
  name       = "zitadel-masterkey"
  path       = "${local.secret_path_prefix}/zitadel"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "zitadel_masterkey" {
  secret_id   = scaleway_secret.zitadel_masterkey.id
  region      = var.region
  data        = random_password.zitadel_masterkey.result
  description = "ZITADEL_MASTERKEY (exactly 32 chars)"
}

resource "scaleway_secret" "backup_s3_access_key" {
  name       = "s3-access-key"
  path       = "${local.secret_path_prefix}/backup"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "backup_s3_access_key" {
  secret_id   = scaleway_secret.backup_s3_access_key.id
  region      = var.region
  data        = scaleway_iam_api_key.backup.access_key
  description = "S3 access key of the quill-backup-writer IAM application"
}

resource "scaleway_secret" "backup_s3_secret_key" {
  name       = "s3-secret-key"
  path       = "${local.secret_path_prefix}/backup"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "backup_s3_secret_key" {
  secret_id   = scaleway_secret.backup_s3_secret_key.id
  region      = var.region
  data        = scaleway_iam_api_key.backup.secret_key
  description = "S3 secret key of the quill-backup-writer IAM application"
}

resource "scaleway_secret" "kubeconfig" {
  name        = "kubeconfig"
  path        = "${local.secret_path_prefix}/k8s"
  project_id  = scaleway_account_project.quill.id
  region      = var.region
  protected   = false
  description = "Kapsule admin kubeconfig (CI uses the scoped quill-ci-deployer key instead)"
}

resource "scaleway_secret_version" "kubeconfig" {
  secret_id   = scaleway_secret.kubeconfig.id
  region      = var.region
  data        = scaleway_k8s_cluster.quill.kubeconfig[0].config_file
  description = "admin kubeconfig for the Kapsule cluster"
}

# Quill metadata DB URL, using the RDB private IP (in-cluster). sslmode=require
# is enforced on the instance.
resource "scaleway_secret" "quill_database_url" {
  name       = "quill-database-url"
  path       = "${local.secret_path_prefix}/app"
  project_id = scaleway_account_project.quill.id
  region     = var.region
  protected  = false
}

resource "scaleway_secret_version" "quill_database_url" {
  secret_id   = scaleway_secret.quill_database_url.id
  region      = var.region
  data        = "postgres://quill:${random_password.rdb_admin.result}@${scaleway_rdb_instance.quill.private_ip[0].address}:5432/quill?sslmode=require"
  description = "QUILL_DATABASE_URL (private endpoint)"
}
